{
  "name": "Hooklinesinker",
  "branch": "main",
  "version_parts": 3,
  "initial_version": "1.0.0",
  "sign": true,
  "preflight": [["just", "check"]],
  "tools": ["git", "python3", "just", "cargo", "node", "npm"],
  "stages": [
    {
      "files": ["Cargo.toml", "Cargo.lock"],
      "commands": [["python3", "scripts/prepare_release.py", "{version}"]],
      "message": "chore: release {version}"
    }
  ],
  "repository": "nielsmadan/hooklinesinker",
  "workflow": "release.yml",
  "success_message": "GitHub Actions will build and automatically publish the release with macOS/Linux binaries and SHA256SUMS"
}
